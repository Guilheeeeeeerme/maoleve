#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG_DIR="${MAOLEVE_CONFIG_DIR:-$HOME/.config/maoleve}"
STATE_DIR="${MAOLEVE_STATE_DIR:-$HOME/.local/share/maoleve}"

source_env() {
  if [[ -f "$CONFIG_DIR/config.env" ]]; then
    # shellcheck disable=SC1090
    set -a
    . "$CONFIG_DIR/config.env"
    set +a
  fi
}

source_versions() {
  # shellcheck disable=SC1090
  if [[ -f "$ROOT_DIR/versions.env" ]]; then
    . "$ROOT_DIR/versions.env"
  fi
  if [[ -f "$STATE_DIR/versions.env" ]]; then
    . "$STATE_DIR/versions.env"
  fi
}

have() {
  command -v "$1" >/dev/null 2>&1
}

need_dir() {
  mkdir -p "$1"
}

show_prereqs() {
  local tools=(
    bash git curl mkdir ln cp chmod sed awk
    headroom rtk codex opencode cursor-agent cursor claude serena caveman gh
  )
  printf '%s\n' "Mão leve prereqs"
  printf '%s\n' "---------------"
  for tool in "${tools[@]}"; do
    if [[ "$tool" == "caveman" ]]; then
      if [[ -f "$ROOT_DIR/.agents/skills/caveman/SKILL.md" || -f "$HOME/.config/opencode/plugins/caveman/plugin.js" || -f "$HOME/.config/opencode/skills/caveman/SKILL.md" ]]; then
        printf 'ok   %s -> skill/plugin installed\n' "$tool"
      else
        printf 'miss %s\n' "$tool"
      fi
    elif have "$tool"; then
      printf 'ok   %s -> %s\n' "$tool" "$(command -v "$tool" 2>/dev/null || true)"
    else
      printf 'miss %s\n' "$tool"
    fi
  done
}

show_versions() {
  source_versions
  printf '%s\n' "Mão leve locked versions"
  printf '%s\n' "-----------------------"
  for item in \
    "headroom:${MAOLEVE_HEADROOM_VERSION:-unset}" \
    "rtk:${MAOLEVE_RTK_VERSION:-unset}" \
    "codex:${MAOLEVE_CODEX_VERSION:-unset}" \
    "opencode:${MAOLEVE_OPENCODE_VERSION:-unset}" \
    "cursor-agent:${MAOLEVE_CURSOR_AGENT_VERSION:-unset}" \
    "cursor-binary:${MAOLEVE_CURSOR_BINARY:-unset}" \
    "tokensave:${MAOLEVE_TOKENSAVE_VERSION:-unset}" \
    "serena:${MAOLEVE_SERENA_VERSION:-unset}" \
    "caveman-plugin:${MAOLEVE_CAVEMAN_PLUGIN_VERSION:-unset}"; do
    printf '%s\n' "$item"
  done
}

extract_version() {
  local text="$1"
  grep -oE '[0-9]+(\.[0-9]+)+([.-][A-Za-z0-9]+)?' <<<"$text" | head -n1
}

older_version() {
  local expected="$1"
  local actual="$2"
  local expected_major expected_minor expected_patch
  local actual_major actual_minor actual_patch

  [[ "$expected" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+) ]] || return 1
  expected_major="${BASH_REMATCH[1]}"
  expected_minor="${BASH_REMATCH[2]}"
  expected_patch="${BASH_REMATCH[3]}"
  [[ "$actual" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+) ]] || return 1
  actual_major="${BASH_REMATCH[1]}"
  actual_minor="${BASH_REMATCH[2]}"
  actual_patch="${BASH_REMATCH[3]}"

  [[ 10#$actual_major -lt 10#$expected_major ||
    (10#$actual_major -eq 10#$expected_major && 10#$actual_minor -lt 10#$expected_minor) ||
    (10#$actual_major -eq 10#$expected_major && 10#$actual_minor -eq 10#$expected_minor &&
      10#$actual_patch -lt 10#$expected_patch) ]]
}

warn_if_older_version() {
  local tool="$1"
  local expected="$2"
  local actual="$3"
  if older_version "$expected" "$actual"; then
    printf 'warning: %s %s is older than supported %s\n' \
      "$tool" "$actual" "$expected" >&2
  fi
}

require_version() {
  local tool="$1"
  local expected="$2"
  local actual=""
  local output=""
  if ! have "$tool"; then
    printf 'miss %s\n' "$tool" >&2
    return 1
  fi
  case "$tool" in
    cursor)
      actual="$(command -v cursor 2>/dev/null || true)"
      if [[ "$actual" != "$expected" ]]; then
        warn_if_older_version "$tool" "$expected" "$actual"
      fi
      ;;
    *)
      output="$("$tool" --version 2>/dev/null || true)"
      actual="$(extract_version "$output")"
      if [[ -z "$actual" ]]; then
        return 0
      fi
      if [[ "$actual" != "$expected" ]]; then
        warn_if_older_version "$tool" "$expected" "$actual"
      fi
      ;;
  esac
}

require_caveman_plugin() {
  local expected="$1"
  local file="$HOME/.config/opencode/plugins/caveman/package.json"
  local actual=""
  if [[ ! -f "$file" ]]; then
    printf 'miss caveman-plugin %s\n' "$file" >&2
    return 1
  fi
  actual="$(grep -oE '"version":"[^"]+"' "$file" | head -n1 | cut -d'"' -f4)"
  if [[ "$actual" != "$expected" ]]; then
    warn_if_older_version "caveman-plugin" "$expected" "$actual"
  fi
}

remove_codex_headroom_mcp() {
  local file="$HOME/.codex/config.toml"
  local temp_file=""
  [[ -f "$file" ]] || return 0
  if ! awk '
    /^[mcp_servers\.headroom]$/ { in_section=1; next }
    in_section && /^\[/ { in_section=0 }
    in_section { print }
  ' "$file" | grep -qE 'command = ".*/headroom"|args = \["mcp", "serve"\]'; then
    return 0
  fi
  temp_file="$(mktemp "${file}.tmp.XXXXXX")"
  awk '
    /^[mcp_servers\.headroom]$/ { in_section=1; next }
    in_section && /^\[/ { in_section=0 }
    !in_section { print }
  ' "$file" >"$temp_file"
  chmod --reference="$file" "$temp_file"
  mv "$temp_file" "$file"
}

enforce_versions() {
  source_versions
  local failed=0
  if [[ -n "${MAOLEVE_HEADROOM_VERSION:-}" ]]; then require_version headroom "$MAOLEVE_HEADROOM_VERSION" || failed=1; fi
  if [[ -n "${MAOLEVE_RTK_VERSION:-}" ]]; then require_version rtk "$MAOLEVE_RTK_VERSION" || failed=1; fi
  if [[ -n "${MAOLEVE_CODEX_VERSION:-}" ]]; then require_version codex "$MAOLEVE_CODEX_VERSION" || failed=1; fi
  if [[ -n "${MAOLEVE_OPENCODE_VERSION:-}" ]]; then require_version opencode "$MAOLEVE_OPENCODE_VERSION" || failed=1; fi
  if [[ -n "${MAOLEVE_CURSOR_AGENT_VERSION:-}" ]]; then require_version cursor-agent "$MAOLEVE_CURSOR_AGENT_VERSION" || failed=1; fi
  if [[ -n "${MAOLEVE_CURSOR_BINARY:-}" ]]; then require_version cursor "$MAOLEVE_CURSOR_BINARY" || failed=1; fi
  if [[ -n "${MAOLEVE_TOKENSAVE_VERSION:-}" ]]; then require_version tokensave "$MAOLEVE_TOKENSAVE_VERSION" || failed=1; fi
  if [[ -n "${MAOLEVE_SERENA_VERSION:-}" ]]; then require_version serena "$MAOLEVE_SERENA_VERSION" || failed=1; fi
  if [[ -n "${MAOLEVE_CAVEMAN_PLUGIN_VERSION:-}" ]]; then require_caveman_plugin "$MAOLEVE_CAVEMAN_PLUGIN_VERSION" || failed=1; fi
  if (( failed )); then
    printf '%s\n' "Mão leve prerequisite check failed. Refusing to run." >&2
    exit 1
  fi
}

install_links() {
  need_dir "$CONFIG_DIR"
  need_dir "$STATE_DIR"
  need_dir "$HOME/.local/bin"
  need_dir "$HOME/.claude"
  need_dir "$HOME/.codex"
  need_dir "$HOME/.config/opencode"
  need_dir "$HOME/.cursor/rules"

  cat >"$CONFIG_DIR/config.env" <<'EOF'
HEADROOM_SAVINGS_PROFILE=coding
HEADROOM_TOOL_SEARCH=1
ENABLE_TOOL_SEARCH=1
MAOLEVE_NO_TESTS=1
MAOLEVE_NO_REFACTOR=1
EOF

  ln -sfn "$ROOT_DIR/AGENTS.md" "$STATE_DIR/AGENTS.md"
  ln -sfn "$ROOT_DIR/versions.env" "$STATE_DIR/versions.env"
  ln -sfn "$ROOT_DIR/AGENTS.md" "$HOME/.claude/CLAUDE.md"
  ln -sfn "$ROOT_DIR/AGENTS.md" "$HOME/.config/opencode/AGENTS.md"
  ln -sfn "$ROOT_DIR/templates/cursor/maoleve.mdc" "$HOME/.cursor/rules/maoleve.mdc"
  ln -sfn "$ROOT_DIR/templates/codex/AGENTS.md" "$HOME/.codex/AGENTS.md"
  ln -sfn "$ROOT_DIR/bin/maoleve" "$HOME/.local/bin/maoleve"
}

write_env_files() {
  need_dir "$CONFIG_DIR"

  cat >"$CONFIG_DIR/env.sh" <<'EOF'
# Mão leve shell defaults.
# Fill secrets in ~/.config/maoleve/env.local if you want them outside your shell history.
export HEADROOM_PROJECT="${HEADROOM_PROJECT:-Code}"
export HEADROOM_MODE="${HEADROOM_MODE:-token}"
export HEADROOM_TOOL_SEARCH="${HEADROOM_TOOL_SEARCH:-1}"
export ENABLE_TOOL_SEARCH="${ENABLE_TOOL_SEARCH:-1}"
export MAOLEVE_NO_TESTS="${MAOLEVE_NO_TESTS:-1}"
export MAOLEVE_NO_REFACTOR="${MAOLEVE_NO_REFACTOR:-1}"

if [ -f "$HOME/.config/maoleve/env.local" ]; then
  . "$HOME/.config/maoleve/env.local"
fi
EOF

  cat >"$CONFIG_DIR/env.local.example" <<'EOF'
# Mão leve secret placeholders.
# Copy this to ~/.config/maoleve/env.local and fill the values you use.
# export OPENAI_API_KEY="..."
# export ANTHROPIC_API_KEY="..."
# export CONTEXT7_API_KEY="..."
# export FIRECRAWL_API_KEY="..."
# export HEADROOM_PROJECT="Code"
EOF

  if ! rg -q "BEGIN MAOLEVE" "$HOME/.bashrc" 2>/dev/null; then
    cat >>"$HOME/.bashrc" <<'EOF'

# BEGIN MAOLEVE
# Mão leve shell policy.
# export OPENAI_API_KEY="..."
# export ANTHROPIC_API_KEY="..."
# export CONTEXT7_API_KEY="..."
# export FIRECRAWL_API_KEY="..."
# export HEADROOM_PROJECT="Code"
if [ -f "$HOME/.config/maoleve/env.sh" ]; then
  . "$HOME/.config/maoleve/env.sh"
fi
# END MAOLEVE
EOF
  fi
}

write_cursor_mcp() {
  need_dir "$HOME/.cursor"
  cat >"$HOME/.cursor/mcp.json" <<EOF
{
  "mcpServers": {
    "headroom": {
      "command": "$HOME/.local/bin/headroom",
      "args": ["mcp", "serve"]
    },
    "serena": {
      "command": "$HOME/.local/bin/uvx",
      "args": ["--from", "git+https://github.com/oraios/serena", "serena", "start-mcp-server", "--project-from-cwd", "--context", "ide"]
    },
    "tokensave": {
      "command": "$HOME/.local/bin/tokensave",
      "args": ["serve"]
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY:-}"
      }
    },
    "firecrawl": {
      "command": "npx",
      "args": ["-y", "firecrawl-mcp"],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY:-}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    }
  }
}
EOF
}

write_codex_config() {
  need_dir "$HOME/.codex"
  cat >"$HOME/.codex/config.toml" <<EOF
model_provider = "headroom"
openai_base_url = "http://127.0.0.1:8787/v1"
model = "gpt-5.6-luna"
model_reasoning_effort = "medium"

[features]
hooks = true

[hooks.state."$HOME/.codex/hooks.json:pre_tool_use:0:0"]
trusted_hash = "sha256:0c98f208c54fd07b84210d0a0182a9fdd8c3c49d99938a50f87391493beae239"

[hooks.state."$HOME/.codex/hooks.json:session_start:0:0"]
trusted_hash = "sha256:c22e07f85f1edc842b84caef85684c1e77815e408b2b68c600a57f45d1caaee4"

[mcp_servers.serena]
command = "$HOME/.local/bin/uvx"
args = ["--from", "git+https://github.com/oraios/serena", "serena", "start-mcp-server", "--project-from-cwd", "--context", "codex"]

[mcp_servers.tokensave]
command = "$HOME/.local/bin/tokensave"
args = ["serve"]

[mcp_servers.context7]
url = "https://mcp.context7.com/mcp"

[mcp_servers.context7.http_headers]
CONTEXT7_API_KEY = "${CONTEXT7_API_KEY:-}"

[mcp_servers.firecrawl]
command = "npx"
args = ["-y", "firecrawl-mcp"]

[mcp_servers.firecrawl.env]
FIRECRAWL_API_KEY = "${FIRECRAWL_API_KEY:-}"

[mcp_servers.playwright]
command = "npx"
args = ["@playwright/mcp@latest"]

[model_providers.headroom]
base_url = "http://127.0.0.1:8787/v1"
name = "OpenAI via Headroom proxy"
requires_openai_auth = true
supports_websockets = true

[projects."$HOME"]
trust_level = "trusted"
EOF
}

write_opencode_config() {
  need_dir "$HOME/.config/opencode"
  mkdir -p "$HOME/.config/opencode/plugins/caveman"
  cat >"$HOME/.config/opencode/opencode.json" <<EOF
{
  "\$schema": "https://opencode.ai/config.json",
  "plugin": ["./plugins/caveman/plugin.js"],
  "mcp": {
    "headroom": {
      "type": "local",
      "command": ["$HOME/.local/bin/headroom", "mcp", "serve"],
      "enabled": true
    },
    "tokensave": {
      "type": "local",
      "command": ["$HOME/.local/bin/tokensave", "serve"]
    },
    "serena": {
      "type": "local",
      "command": ["$HOME/.local/bin/uvx", "--from", "git+https://github.com/oraios/serena", "serena", "start-mcp-server", "--project-from-cwd", "--context", "agent"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY:-}"
      }
    },
    "firecrawl": {
      "type": "local",
      "command": ["npx", "-y", "firecrawl-mcp"],
      "enabled": true,
      "environment": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY:-}"
      }
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    }
  },
  "instructions": ["$HOME/.config/opencode/AGENTS.md"]
}
EOF
}

write_claude_policy() {
  need_dir "$HOME/.claude"
  cat >"$HOME/.claude/CLAUDE.md" <<'EOF'
# Mão leve Policy

- Keep the harness Linux-only and shell-first.
- Prefer the smallest sufficient tool chain.
- Use Headroom for context compression and proxying when available.
- Use RTK for shell output compression when available.
- Use Caveman for terse model output, compact reviews, and commit text.
- Use Serena only when symbol-level navigation or memory is needed.
- Do not run broad tests or broad refactors unless explicitly requested.
- Start with targeted reads and exact searches before anything larger.
- Treat `versions.env` as the lock file; refuse drift instead of upgrading blindly.
- Overwrite stale local config for this repo; do not preserve irrelevant legacy setup.
- Keep all user-facing text in English.
EOF
}

apply_configs() {
  install_links
  write_env_files
  write_cursor_mcp
  write_codex_config
  write_opencode_config
  write_claude_policy
  if have rtk; then
    rtk init --global || true
    rtk init --global --agent cursor || true
    rtk init --global --codex || true
    rtk init --global --opencode || true
  fi
  printf '%s\n' "Mão leve configs written."
  printf '%s\n' "If Claude Code is installed, run the Claude setup commands from README or maoleve claude."
}

install_optional_tools() {
  source_versions
  if ! have uv; then
    printf '%s\n' "Installing uv..."
    curl -LsSf https://astral.sh/uv/install.sh | sh
  fi

  if ! have headroom; then
    printf '%s\n' "Installing headroom..."
    uv tool install "headroom-ai[all]==${MAOLEVE_HEADROOM_VERSION}"
  fi

  if ! have serena; then
    printf '%s\n' "Installing serena..."
    uv tool install -p 3.13 "serena-agent==${MAOLEVE_SERENA_VERSION}" || true
  fi

  if ! have rtk; then
    printf '%s\n' "Installing rtk..."
    curl -fsSL https://raw.githubusercontent.com/rtk-ai/rtk/main/install.sh | sh
  fi

  if have npx; then
    npx -y github:JuliusBrussee/caveman -- --only opencode || true
    npx -y skills add JuliusBrussee/caveman -a codex --yes || true
    npx -y skills add JuliusBrussee/caveman -a cursor --with-init --yes || true
  fi
}

setup_claude() {
  if ! have claude; then
    printf '%s\n' "Claude Code is not installed. Install it first, then rerun maoleve claude."
    printf '%s\n' "Suggested: npm install -g @anthropic-ai/claude-code"
    return 0
  fi

  if have headroom; then
    headroom mcp install --force || true
  fi

  claude install-plugin JuliusBrussee/caveman-marketplace caveman || true
  claude mcp add --scope user headroom -- "$HOME/.local/bin/headroom" mcp serve || true
  claude mcp add --scope user serena -- "$HOME/.local/bin/uvx" --from git+https://github.com/oraios/serena serena start-mcp-server --project-from-cwd --context claude-code || true
  claude mcp add --scope user tokensave -- "$HOME/.local/bin/tokensave" serve || true
  claude mcp add --scope user context7 -- npx -y @upstash/context7-mcp@latest || true
  claude mcp add --scope user firecrawl -- npx -y firecrawl-mcp || true
  claude mcp add --scope user playwright -- npx @playwright/mcp@latest || true
}

doctor() {
  show_prereqs
  printf '\n%s\n' "Harness links"
  printf '%s\n' "-------------"
  for path in \
    "$HOME/.claude/CLAUDE.md" \
    "$HOME/.config/opencode/AGENTS.md" \
    "$HOME/.cursor/rules/maoleve.mdc" \
    "$HOME/.cursor/mcp.json" \
    "$HOME/.codex/config.toml" \
    "$HOME/.config/opencode/opencode.json" \
    "$HOME/.config/maoleve/env.sh" \
    "$HOME/.local/bin/maoleve"; do
    if [[ -e "$path" || -L "$path" ]]; then
      printf 'ok   %s\n' "$path"
    else
      printf 'miss %s\n' "$path"
    fi
  done
}

wrap_agent() {
  local agent="${1:-}"
  shift || true

  enforce_versions
  source_env
  export HEADROOM_SAVINGS_PROFILE="${HEADROOM_SAVINGS_PROFILE:-coding}"
  export HEADROOM_TOOL_SEARCH="${HEADROOM_TOOL_SEARCH:-1}"
  export ENABLE_TOOL_SEARCH="${ENABLE_TOOL_SEARCH:-1}"
  export MAOLEVE_ROOT="$ROOT_DIR"

  if [[ "$agent" == "codex" ]]; then
    remove_codex_headroom_mcp
  fi

  case "$agent" in
    codex|opencode|claude)
      if have headroom; then
        if [[ "$agent" == "codex" ]]; then
          exec headroom wrap codex --no-mcp "$@"
        fi
        exec headroom wrap "$agent" "$@"
      fi
      ;;
    cursor)
      if have headroom; then
        exec headroom wrap cursor "$@"
      fi
      ;;
    cursor-agent)
      if have headroom; then
        exec headroom wrap codex "$@"
      fi
      ;;
  esac

  case "$agent" in
    codex) exec codex "$@" ;;
    opencode) exec opencode "$@" ;;
    claude) exec claude "$@" ;;
    cursor) exec cursor "$@" ;;
    cursor-agent) exec cursor-agent "$@" ;;
    *)
      printf 'maoleve: unknown agent: %s\n' "$agent" >&2
      exit 2
      ;;
  esac
}

setup_cursor() {
  enforce_versions
  if have headroom; then
    headroom wrap cursor
  else
    printf '%s\n' "Headroom is not installed."
    printf '%s\n' "Use the policy in PROMPT.md and set the model base URL manually in Cursor."
  fi
}

print_prompt() {
  cat "$ROOT_DIR/PROMPT.md"
}

usage() {
  cat <<'EOF'
Usage:
  maoleve prereqs
  maoleve versions
  maoleve install
  maoleve apply
  maoleve tools
  maoleve claude
  maoleve doctor
  maoleve wrap <codex|opencode|claude|cursor|cursor-agent> [args...]
  maoleve setup cursor
  maoleve prompt
EOF
}

main() {
  local cmd="${1:-}"
  shift || true

  case "$cmd" in
    prereqs) show_prereqs ;;
    versions) show_versions ;;
    install) install_links ;;
    apply) apply_configs ;;
    tools) install_optional_tools ;;
    claude) setup_claude ;;
    doctor) doctor ;;
    wrap) wrap_agent "${1:-}" "${@:2}" ;;
    setup)
      case "${1:-}" in
        cursor) setup_cursor ;;
        *) usage; exit 2 ;;
      esac
      ;;
    prompt) print_prompt ;;
    ""|-h|--help|help) usage ;;
    *)
      printf 'maoleve: unknown command: %s\n' "$cmd" >&2
      usage
      exit 2
      ;;
  esac
}

main "$@"
